[run]
omit =
    tests/*
    */tests/*
    setup.py
    venv/*
    */venv/*
    __pycache__/*
    */__pycache__/*
    .git/*
    */thread_reader.py
    thread_reader.py
    */web_scraper.py
    web_scraper.py
    */youtube_transcript.py
    youtube_transcript.py
    */obsidian_prep.py
    obsidian_prep.py
    */research_digest_tui/__main__.py
    research_digest_tui/__main__.py

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod
