/* Global CSS styles for Research Digest TUI
 * Using Textual's built-in design system
 * Colors match Rich theme: success=green, error=red, warning=yellow, info=blue, header=cyan
 */

/* Screen-level styling */
Screen {
    background: $background;
}

/* Header styling - cyan for headers matching Rich theme */
.header {
    color: cyan;
    text-style: bold;
}

/* Success messages - green */
.success {
    color: green;
    text-style: bold;
}

/* Error messages - red */
.error {
    color: red;
    text-style: bold;
}

/* Warning messages - yellow */
.warning {
    color: yellow;
    text-style: bold;
}

/* Info messages - blue */
.info {
    color: blue;
    text-style: bold;
}

/* Muted text */
.muted {
    color: $text-muted;
}

/* Footer styling */
.footer {
    background: $panel;
    color: $text;
    height: 1;
}
