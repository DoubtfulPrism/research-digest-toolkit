/* Scraper Management screen styles */

.screen-title {
    text-style: bold;
    color: cyan;
    text-align: center;
    padding: 1;
    margin-bottom: 1;
}

#scrapers-list {
    height: auto;
}

.scraper-row {
    border: solid $primary;
    padding: 1;
    margin: 1;
    height: auto;
}

.scraper-name {
    text-style: bold;
    color: $accent;
    margin-bottom: 1;
}

.scraper-config {
    color: $text-muted;
    margin-bottom: 1;
}

.scraper-last-run {
    color: $text-muted;
    margin-bottom: 1;
}

.scraper-actions {
    height: auto;
}

.scraper-actions Button {
    margin-right: 1;
}

.bottom-actions {
    height: auto;
    padding: 1;
    background: $panel;
}

.bottom-actions Button {
    margin-right: 1;
}
