#workspace_container {
    height: 1fr;
    padding: 0 1;
}

#left_pane {
    width: 30%;
    border-right: tall $primary;
    padding: 1;
}

#center_pane {
    width: 40%;
    padding: 1 2;
    border-right: tall $primary;
}

#right_pane {
    width: 30%;
    padding: 1;
}

.pane-title {
    text-align: center;
    text-style: bold;
    background: $primary-darken-1;
    color: white;
    margin-bottom: 1;
}

.settings-group {
    height: auto;
    margin-bottom: 2;
}

.label {
    text-style: bold;
    margin-top: 1;
    color: $accent;
}

Input {
    margin-bottom: 1;
}

Select {
    margin-bottom: 1;
}

#process_btn {
    width: 100%;
}

.log-view {
    height: 1fr;
    border: solid $primary;
    background: $surface;
}
