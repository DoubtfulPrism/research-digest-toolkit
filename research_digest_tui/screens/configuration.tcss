/* Configuration screen styles */

.screen-title {
    text-style: bold;
    color: cyan;
    text-align: center;
    padding: 1;
    margin-bottom: 1;
}

.placeholder-container {
    border: solid $primary;
    padding: 2;
    margin: 2;
    height: auto;
}

.placeholder-heading {
    text-style: bold;
    color: $accent;
    text-align: center;
    margin-bottom: 1;
}

.placeholder-message {
    color: $text-muted;
    text-align: center;
    margin-bottom: 1;
}

.config-path {
    color: $text;
    text-align: center;
    margin-bottom: 1;
}

.section-label {
    text-style: bold;
    color: $accent;
    margin-top: 1;
    margin-bottom: 1;
}

.scraper-tabs {
    height: auto;
}

.scraper-tabs Button {
    margin-right: 1;
}

.bottom-actions {
    height: auto;
    padding: 1;
    background: $panel;
}

.bottom-actions Button {
    margin-right: 1;
}
