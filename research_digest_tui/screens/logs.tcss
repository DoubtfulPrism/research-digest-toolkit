/* Logs screen styles — scoped to #logs-screen to prevent cascade conflicts */

#logs-screen .log-filter-row {
    height: auto;
}

#logs-screen .log-filter-row Button {
    margin-right: 1;
}

#logs-screen .log-area-placeholder {
    color: $text-muted;
    text-align: center;
    margin-top: 2;
    padding: 2;
    border: dashed $primary-darken-2;
}
