/* History/Analytics screen styles — scoped to #history-screen to prevent cascade conflicts */

#history-screen .time-range-row {
    height: auto;
}

#history-screen .time-range-row Button {
    margin-right: 1;
}

#history-screen .chart-area-placeholder {
    color: $text-muted;
    text-align: center;
    margin-top: 2;
    padding: 2;
    border: dashed $primary-darken-2;
}
