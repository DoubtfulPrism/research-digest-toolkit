/* Dashboard screen styles */

.status-bar {
    background: $panel;
    color: $text;
    padding: 1;
    text-style: bold;
    margin-bottom: 1;
}

.section-header {
    color: $accent;
    text-style: bold;
    margin-top: 1;
    margin-bottom: 1;
}

.scrapers-grid {
    height: auto;
}

.scrapers-grid Horizontal {
    height: auto;
}

.activity-log {
    height: 10;
    border: solid $primary;
    padding: 1;
}
